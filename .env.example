# This will be an example of a Docker environment file for the junknuke agent.
# Copy this file to .env and modify the values as needed.

# JunkNuke Agent Configuration
# ── Your Email address (Account B — the junk account) ───────────────
MAIL_ACCOUNTS = ""      # ← change this

# ── Azure app Client ID (from your JunkUnsubscriber app registration) ─────────
AZURE_CLIENT_ID = ""     # ← change this

# ── Behaviour ─────────────────────────────────────────────────────────────────

RUN_INTERVAL = 86400  # Seconds between runs (24 hours)

# Only process emails older than this many days
MIN_AGE_DAYS = 0

# Seconds to wait between unsubscribe requests
REQUEST_DELAY_SECONDS = 2

# Delete emails from junk folder if no unsubscribe mechanism is found
DELETE_IF_NO_UNSUB = True

# Delete email from junk after a successful unsubscribe attempt
DELETE_AFTER_UNSUB = True

# ── Senders / domains to never unsubscribe from ───────────────────────────────
ALLOWLIST = [
    # "newsletter@companyyoulike.com",
    # "updates@bank.com",
]

# ── File paths ────────────────────────────────────────────────────────────────
LOG_FILE        = "junknuke.log"
PROCESSED_FILE  = "processed.json"
TOKEN_FILE      = "token.json"         # keep this private — treat like a password

# ── Geo tracking ──────────────────────────────────────────────────────────────

# Set to True to enable source IP tracking and geo-lookup
ENABLE_GEOTRACK = True

# Geolocation API Configuration
GEOLOCATION_API_URL="http://ip-api.com/json"

# InfluxDB connection for host networking
INFLUXDB_URL_HOST="http://localhost:8086"

# InfluxDB connection for docker networking
INFLUXDB_URL_DOCKER="http://influxdb2:8086"

# Shared InfluxDB Configuration
INFLUXDB_ORG="junknuke"
INFLUXDB_BUCKET="default"
INFLUXDB_MESSAGES_BUCKET="messages"
INFLUXDB_STATS_BUCKET="stats"
INFLUXDB_ADMIN_USER="admin" # Replace with your actual DB user
INFLUXDB_ADMIN_PASSWORD="" # Replace with your actual DB password

# Grafana configuration
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD=""
